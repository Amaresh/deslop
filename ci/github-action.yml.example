# Copy into a consuming repo that vendors this pack as ./stopthatslop (a checkout of
# the stopthatslop repository). Not a hosted Action.
#
# scripts/ci.sh puts scripts/ on PYTHONPATH. Python 3.11+ and PyYAML>=6;
# `pip install -e .` provides the `stopthatslop` console script.
#
# Extra toolchains, only if that language is in the repo:
#   Java AST checkers: JDK 21 (javac/java). JavaParser jar is fetched once.
#   TypeScript checkers: Node + npm (checkers/tsast).
#   Go checkers: Go 1.21+ (builds checkers/goast).
# Python and Android checkers are stdlib / in-process.
name: stopthatslop pack check

on:
  pull_request:

jobs:
  stopthatslop:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - uses: actions/setup-node@v4
        with:
          node-version: "22"

      - uses: actions/setup-go@v5
        with:
          go-version: "1.22"

      - name: Install stopthatslop
        run: pip install -e ./stopthatslop

      - name: Run pack checker
        env:
          FORMAT: json
          ENGINE_PYTHON: python3
        run: bash stopthatslop/scripts/ci.sh "$GITHUB_WORKSPACE"
